{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clip",
  "type": "object",
  "required": ["title", "source", "created", "tags"],
  "properties": {
    "title": { "type": "string" },
    "source": { "type": "string", "pattern": "^(https?://|mid:|file://)" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "clip" }
    }
  }
}
