{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "person",
  "type": "object",
  "required": ["last_met", "meeting_count", "topics"],
  "properties": {
    "last_met": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "meeting_count": { "type": "integer", "minimum": 0 },
    "topics": { "type": "array", "items": { "type": "string" } }
  }
}
