{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "session-trace",
  "type": "object",
  "required": ["date", "slug", "loop_levels_touched", "tags"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "slug": { "type": "string" },
    "duration_estimate": { "type": "string" },
    "loop_levels_touched": { "type": "array", "items": { "type": "string" } },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "session-trace" }
    }
  }
}
