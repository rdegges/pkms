{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "recipe",
  "type": "object",
  "required": ["type", "servings", "course", "tags"],
  "dependentRequired": { "calories_per_serving": ["macros_estimated"] },
  "properties": {
    "type": { "const": "recipe" },
    "servings": { "type": "integer", "minimum": 1 },
    "course": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "recipe" }
    },
    "domain": { "type": "string" },
    "status": { "type": "string" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source_url": { "type": "string" },
    "source_type": { "type": "string" },
    "cuisine": { "type": "string" },
    "prep_time_min": { "type": "integer", "minimum": 0 },
    "cook_time_min": { "type": "integer", "minimum": 0 },
    "total_time_min": { "type": "integer", "minimum": 0 },
    "calories_per_serving": { "type": "integer", "minimum": 0 },
    "macros_estimated": { "type": "boolean" },
    "dietary": { "type": "array", "items": { "type": "string" } }
  }
}
