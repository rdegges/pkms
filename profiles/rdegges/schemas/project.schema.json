{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project",
  "type": "object",
  "required": ["type", "category", "status", "created", "updated", "description"],
  "properties": {
    "type": { "const": "project" },
    "category": { "enum": ["Snyk", "Personal"] },
    "status": { "type": "string" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "repo": { "type": "string" },
    "github": { "type": "string" },
    "url": { "type": "string" },
    "related": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\[\\[[^\\]|#]+\\]\\]$" }
    },
    "is_oss": { "type": "boolean" },
    "language": { "type": "string" },
    "stars": { "type": "integer" }
  }
}
