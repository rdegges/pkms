{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "action-items",
  "type": "object",
  "required": ["updated", "total_items"],
  "properties": {
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "total_items": { "type": "integer", "minimum": 0 }
  }
}
