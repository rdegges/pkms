# Phase 14: secrets never live in config — a configured IMAP source with no
# credential fails with copy that names every place pkms looked and the
# exact commands to fix it. (Headless env: the OS keyring is unavailable,
# so resolution falls through to env/password_cmd exactly as documented.)

exec pkms init --path $WORK/vault
exec sh -c 'cat ingester.toml >> "$PKMS_CONFIG"'

# No password anywhere → the error teaches the fix.
! exec pkms ingest --source mail
stderr 'no password found for imap:mail'
stderr '\$PKMS_VAULT_MAIL_PASSWORD'
stderr 'pkms secret set mail password'
stderr 'password_cmd'

# secret set refuses sources that are not configured.
! exec pkms secret set nope password
stderr 'no ingester named "nope"'
stderr 'configured: mail'

# Unknown secret kinds are named errors, not silent writes.
! exec pkms secret set mail passw0rd
stderr 'unknown secret kind "passw0rd"'

# pkms auth guards its surface: password sources have nothing to authorize.
! exec pkms auth mail
stderr 'pkms auth is only for auth = "xoauth2" sources'

# password_cmd is an argv array — a shell string is a config error.
exec sh -c 'cat shell-string.toml >> "$PKMS_CONFIG"'
! exec pkms ingest --source cmd
stderr 'argv array'
stderr 'never a shell string'

-- ingester.toml --

  [[vaults.ingesters]]
  type     = "imap"
  name     = "mail"
  host     = "127.0.0.1"
  username = "user@example.com"

-- shell-string.toml --

  [[vaults.ingesters]]
  type         = "imap"
  name         = "cmd"
  host         = "127.0.0.1"
  username     = "user@example.com"
  password_cmd = "op read op://x/y/password"
