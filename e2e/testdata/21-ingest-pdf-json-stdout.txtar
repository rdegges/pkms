# Phase 21: `ingest --json` is a machine-readable contract — stdout carries
# JSON and nothing else, whatever the input file does. The extraction child's
# stdout and stderr go to /dev/null on every path (SPEC §31.6), so no
# extractor can ever land bytes in the middle of the JSON payload. That
# lattice is deliberately engine-independent: the previous engine,
# github.com/ledongthuc/pdf, printed "DEBUG:" lines carrying bytes out of the
# parsed file straight to the process stdout.
#
# TESTER (§31.13): this script used to run only hostile.pdf, whose corrupt
# catalog the current engine simply TOLERATES — so it stopped exercising a
# rejected parse, which is exactly where an extractor is most likely to
# print. Both outcomes are covered now: one document the engine reads, one
# it rejects.

exec pkms init --path $WORK/vault

# A document the engine reads: the JSON is the only thing on stdout.
exec pkms ingest --json hostile.pdf
stdout '^\{'
! stdout 'DEBUG'
! stdout 'x\.png'

# A document the engine REJECTS: the failure still goes to the note, never
# to stdout, and the JSON payload stays parseable from byte one.
exec pkms ingest --json broken.pdf
stdout '^\{'
! stdout 'DEBUG'
exec sh -c 'grep "> Text extraction failed:" "$WORK"/vault/_Inbox/*broken.md'

-- hostile.pdf --
%PDF-1.4
1 0 obj
<< (![[x.png]]) 1 /Pages 2 0 R >>
endobj
2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj
3 0 obj
<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>
endobj
4 0 obj
<< /Length 62 >>
stream
BT /F1 12 Tf 72 720 Td (Hello from the pkms e2e fixture) Tj ET
endstream
endobj
5 0 obj
<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>
endobj
xref
0 6
0000000000 65535 f 
0000000009 00000 n 
0000000058 00000 n 
0000000115 00000 n 
0000000241 00000 n 
0000000353 00000 n 
trailer
<< /Size 6 /Root 1 0 R >>
startxref
423
%%EOF
-- broken.pdf --
%PDF-1.4
1 0 obj
<< /Type /Catalog /Pag
