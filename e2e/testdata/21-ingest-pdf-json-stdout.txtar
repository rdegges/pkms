# Phase 21: `ingest --json` is a machine-readable contract — stdout carries
# JSON and nothing else, whatever the input file does. hostile.pdf is the
# same fixture as phase 20; github.com/ledongthuc/pdf logs parser noise to
# the process stdout (lex.go:491, read.go:341/849/862), echoing bytes out of
# the file, which lands in the middle of the JSON payload.

exec pkms init --path $WORK/vault

exec pkms ingest --json hostile.pdf
stdout '^\{'
! stdout 'DEBUG'

-- hostile.pdf --
%PDF-1.4
1 0 obj
<< (![[x.png]]) 1 /Pages 2 0 R >>
endobj
2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj
3 0 obj
<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>
endobj
4 0 obj
<< /Length 62 >>
stream
BT /F1 12 Tf 72 720 Td (Hello from the pkms e2e fixture) Tj ET
endstream
endobj
5 0 obj
<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>
endobj
xref
0 6
0000000000 65535 f 
0000000009 00000 n 
0000000058 00000 n 
0000000115 00000 n 
0000000241 00000 n 
0000000353 00000 n 
trailer
<< /Size 6 /Root 1 0 R >>
startxref
423
%%EOF
