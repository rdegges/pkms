# Phase 19: the PDF handler (SPEC §31.6) — a pushed PDF lands as an asset
# note whose body is the extracted text, with the PDF itself stored in
# Attachments/ and wikilinked. A garbage "PDF" still lands (asset note +
# one-line hint) — extraction failure is never a refusal.
#
# paper.pdf is a byte-exact minimal PDF (generated by the same layout as
# buildMinimalPDF in internal/ingest/pdf_test.go — xref offsets matter).

exec pkms init --path $WORK/vault

exec pkms ingest paper.pdf
stdout 'ingested → _Inbox/.* - paper\.md'
exists $WORK/vault/Attachments/paper.pdf

# The body carries the extracted text and the attachment embed.
exec sh -c 'grep "Hello from the pkms e2e fixture" "$WORK"/vault/_Inbox/*paper.md'
exec sh -c 'grep -F "![[Attachments/paper.pdf]]" "$WORK"/vault/_Inbox/*paper.md'

# Contract fields (§31.4) on the note.
exec pkms query --type asset --json
stdout '"mime": "application/pdf"'
stdout '"sha256":'

# Re-push dedups on content hash.
exec pkms ingest paper.pdf
stdout 'already ingested → _Inbox/.* - paper\.md'

# A malformed PDF degrades: the note lands with a hint, exit 0 (§31.6).
exec pkms ingest broken.pdf
stdout 'ingested → _Inbox/.* - broken\.md'
exists $WORK/vault/Attachments/broken.pdf
exec sh -c 'grep "> Text extraction failed:" "$WORK"/vault/_Inbox/*broken.md'

-- paper.pdf --
%PDF-1.4
1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj
2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj
3 0 obj
<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>
endobj
4 0 obj
<< /Length 62 >>
stream
BT /F1 12 Tf 72 720 Td (Hello from the pkms e2e fixture) Tj ET
endstream
endobj
5 0 obj
<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>
endobj
xref
0 6
0000000000 65535 f 
0000000009 00000 n 
0000000058 00000 n 
0000000115 00000 n 
0000000241 00000 n 
0000000353 00000 n 
trailer
<< /Size 6 /Root 1 0 R >>
startxref
423
%%EOF
-- broken.pdf --
%PDF-1.5
fake pdf payload that parses as nothing
