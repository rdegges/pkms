# Phase 23: REGRESSION (fixed; pinned — verified RED against the pre-fix
# code). A PDF may not mint graph edges in
# the vault (SPEC §28.9 posture; the pdfBody contract). The neutralizer
# escapes only the first bracket of each `[[` pair, so an ODD run of brackets
# walks through it: `[[[Project Alpha]]` becomes `\[[[Project Alpha]]`, where
# the backslash consumes bracket 1 and brackets 2-3 open a live link.
#
# refs.pdf draws both forms, so the contrast is visible in one note:
#   `[[Project Beta]]`   -> `\[[Project Beta]]`   inert, correct
#   `[[[Project Alpha]]` -> `\[[[Project Alpha]]` LIVE
#
# No renderer guesswork is needed — pkms's own link checker resolves the
# smuggled edge and reports it. Fix: escape every `[`, not every `[[` pair;
# `[12]`-style citations render identically either way.

exec pkms init --path $WORK/vault

exec pkms ingest refs.pdf
stdout 'ingested → _Inbox/.* - refs\.md'

# Ingesting a PDF must never leave the vault with a finding.
exec pkms lint

-- refs.pdf --
%PDF-1.4
1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj
2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj
3 0 obj
<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>
endobj
4 0 obj
<< /Length 82 >>
stream
BT /F1 12 Tf 72 720 Td (References: [[[Project Alpha]] and [[Project Beta]]) Tj ET
endstream
endobj
5 0 obj
<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>
endobj
xref
0 6
0000000000 65535 f 
0000000009 00000 n 
0000000058 00000 n 
0000000115 00000 n 
0000000241 00000 n 
0000000373 00000 n 
trailer
<< /Size 6 /Root 1 0 R >>
startxref
443
%%EOF
