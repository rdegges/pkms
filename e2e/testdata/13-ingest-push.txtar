# Phase 13: push-mode ingest — a local HTML file lands in Inbox/ as a clip
# note, re-ingesting is a byte-identical no-op, hostile inputs are refused
# with copy that says why and what happens instead.

exec pkms init --path $WORK/vault

# HTML file → readability → markdown clip note in Inbox/ (para profile).
exec pkms ingest article.html
stdout 'ingested → Inbox/.* - Interesting Article\.md'

# Second push of identical content: content-addressed dedup, path shown.
exec pkms ingest article.html
stdout 'already ingested → Inbox/.* - Interesting Article\.md'

# The note carries the ingest contract fields.
exec pkms query --type clip --json
stdout '"title": "Interesting Article"'
stdout '"source_id":'

# SSRF guard: loopback is refused at connect time, nothing written.
! exec pkms ingest http://127.0.0.1:9/steal
stderr 'refusing to fetch'
stderr 'private address 127.0.0.1'

# Unsupported content (phase 2.5 territory): honest refusal, exit 2.
! exec pkms ingest report.pdf
stderr 'unsupported content type application/pdf \(PDF/audio/video land in phase 2.5\); nothing was written'

# Non-http(s) schemes never fetch.
! exec pkms ingest ftp://example.com/file
stderr 'not an http\(s\) URL'

-- article.html --
<!DOCTYPE html>
<html>
<head><title>Interesting Article</title></head>
<body>
<nav>navigation chrome that readability strips</nav>
<article>
<h1>Interesting Article</h1>
<p>This is the first paragraph of the article body, long enough for the
readability extractor to keep it around as real content.</p>
<p>A second paragraph keeps the extraction confident about the article.</p>
</article>
</body>
</html>
-- report.pdf --
%PDF-1.5
fake pdf payload
